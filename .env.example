# Doubao 2.0 Pro via Volcengine Ark. Fill the actual model/endpoint ID from your account.
ARK_API_KEY=
OPENAI_API_KEY=
VISION_MODEL=
# Optional OpenAI-compatible endpoint. It must support image input AND structured output.
OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# function_calling/json_schema/json_mode; depends on endpoint capabilities, not Coze display name.
STRUCTURED_METHOD=function_calling
MODEL_TIMEOUT=120
MODEL_MAX_TOKENS=16000
# This project's PaddleOCR HTTP adapter (scripts/serve_paddleocr.py), not the official serving schema.
OCR_ENDPOINT=http://127.0.0.1:8008/ocr
OCR_API_KEY=
# Optional Tesseract executable and language data (installed separately).
TESSERACT_CMD=
OCR_LANG=chi_sim+eng

# LangSmith tracing. Set true after filling your LangSmith API key.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=conduit-drawing-workflows
# Default US endpoint; use your account region's endpoint when different.
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Needed only for keys that cover more than one workspace.
LANGSMITH_WORKSPACE_ID=
