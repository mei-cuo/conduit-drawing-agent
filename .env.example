# Live vision model: OpenAI-compatible image + tool-calling endpoint
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
VISION_MODEL=
STRUCTURED_METHOD=function_calling
MODEL_TIMEOUT=120
# Embeddings: hash (local character ngrams) or openai (semantic embedding API)
EMBEDDING_BACKEND=hash
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
# Empty QDRANT_URL uses local disk; set URL and key for a Qdrant server
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=drawflow_knowledge
DRAWFLOW_HOME=.
# OCR adapter; request image_base64, response width/height/lines
OCR_ENDPOINT=http://127.0.0.1:8008/ocr
OCR_API_KEY=
# Optional observability
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=drawflow-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Optional operator API header X-API-Key
DRAWFLOW_API_KEY=
